{
  "name": "trackglance-watch",
  "description": "TrackGlance displays and controls Locus Map track recordings on supported Pebble Time 2 and Pebble Round 2 smartwatches. Independent and unofficial; not affiliated with or endorsed by Core Devices, Pebble Technology, or Asamm Software.",
  "author": "Christian Herget",
  "version": "0.2.5",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianHerget/trackglance.git"
  },
  "homepage": "https://christianherget.github.io/trackglance/",
  "keywords": [
    "locus",
    "hiking",
    "fitness"
  ],
  "trackglance": {
    "legalNotice": "TrackGlance is an independent, unofficial project. It is not affiliated with, endorsed by, sponsored by, or associated with Core Devices LLC, Pebble Technology Corp., or Asamm Software, s.r.o. Pebble is a trademark of Pebble Technology Corp. Locus Map is a brand of Asamm Software, s.r.o. Those names are used solely to identify compatibility: TrackGlance connects supported Pebble smartwatches with Locus Map. No ownership of those names or marks, or endorsement by their owners, is claimed."
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node test/config.test.js && node test/protocol_parity.test.js && node test/c_core.test.js && node test/watch_stack.test.js",
    "lint": "eslint src/pkjs test eslint.config.js",
    "verify:pbw": "node test/pbw.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "10.9.1",
    "jsdom": "30.0.1"
  },
  "pebble": {
    "displayName": "TrackGlance",
    "shortName": "TrackGlance",
    "uuid": "51c8d7cf-4cb2-4ef8-98c9-641706feb250",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable",
      "health"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu-icon.png",
          "menuIcon": true
        }
      ]
    },
    "messageKeys": {
      "PROTOCOL_VERSION": 0,
      "MESSAGE_TYPE": 1,
      "COMMAND_ID": 2,
      "COMMAND": 3,
      "RESULT": 4,
      "RECORDING_STATE": 5,
      "SAMPLE_EPOCH_SECONDS": 6,
      "SESSION_ID": 7,
      "PROFILE_NAME": 8,
      "LOCUS_PROFILE_NAME": 9,
      "ELAPSED_SECONDS": 10,
      "DISTANCE_VALUE": 11,
      "CURRENT_SPEED_VALUE": 12,
      "AVERAGE_SPEED_VALUE": 13,
      "ALTITUDE_VALUE": 14,
      "ASCENT_VALUE": 15,
      "ALTITUDE_FORMAT": 16,
      "MOVING_SECONDS": 17,
      "MOVING_DISTANCE_VALUE": 18,
      "MAX_SPEED_VALUE": 19,
      "DESCENT_VALUE": 20,
      "VERTICAL_SPEED_VALUE": 21,
      "SLOPE_VALUE": 22,
      "AVERAGE_HEART_RATE": 23,
      "MAX_HEART_RATE": 24,
      "AVERAGE_CADENCE": 25,
      "MAX_CADENCE": 26,
      "AVERAGE_POWER": 27,
      "MAX_POWER": 28,
      "ENERGY_VALUE": 29,
      "CHUNK_INDEX": 30,
      "CHUNK_COUNT": 31,
      "CHUNK_DATA": 32,
      "TRANSFER_ID": 33,
      "LOCUS_MODE": 34,
      "APP_VERSION": 35,
      "WAYPOINT_NAME": 36,
      "CURRENT_HEART_RATE": 37,
      "HEART_RATE_SEQUENCE": 38,
      "TRANSFER_GENERATION": 39,
      "DISTANCE_FORMAT": 40,
      "MOVING_DISTANCE_FORMAT": 41,
      "CURRENT_SPEED_FORMAT": 42,
      "AVERAGE_SPEED_FORMAT": 43,
      "MAX_SPEED_FORMAT": 44,
      "VERTICAL_SPEED_FORMAT": 45,
      "SLOPE_FORMAT": 46,
      "ENERGY_FORMAT": 47,
      "CURRENT_PACE_SECONDS": 48,
      "AVERAGE_PACE_SECONDS": 49,
      "PACE_FORMAT": 50,
      "LOCUS_PROFILE_ID": 51,
      "CONFIG_FINGERPRINT_A": 52,
      "CONFIG_FINGERPRINT_B": 53
    },
    "companionApp": {
      "android": {
        "url": "https://github.com/ChristianHerget/trackglance/releases/latest",
        "apps": [
          {
            "package": "app.trackglance.bridge"
          }
        ]
      }
    }
  }
}
