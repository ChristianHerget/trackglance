release_check() {
  doctor_static
  static_image_exists || build_static_image
  run_static_container bash -euo pipefail -c '
    mkdir -p "$HOME"
    ./gradlew :android:app:assembleRelease
    if [[ -n "${ANDROID_RELEASE_KEYSTORE_PATH:-}" ]]; then
      release_apk=android/app/build/outputs/apk/release/trackglance-bridge-release.apk
    else
      release_apk=android/app/build/outputs/apk/release/trackglance-bridge-release-unsigned.apk
    fi
    test -s "$release_apk"
    badging_file=$(mktemp)
    manifest_file=$(mktemp)
    cleanup_release_policy_inputs() {
      rm -f "$badging_file" "$manifest_file"
    }
    trap cleanup_release_policy_inputs EXIT
    aapt2 dump badging "$release_apk" > "$badging_file"
    aapt2 dump xmltree --file AndroidManifest.xml "$release_apk" > "$manifest_file"
    expected_code=$(sed -nE "s/^[[:space:]]*versionCode[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p" android/app/build.gradle.kts)
    expected_version=$(sed -nE "s/^[[:space:]]*versionName[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\1/p" android/app/build.gradle.kts)
    expected_target=$(sed -nE "s/^[[:space:]]*targetSdk[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p" android/app/build.gradle.kts)
    python3 tools/podman/check_release_manifest.py \
      --badging "$badging_file" \
      --manifest "$manifest_file" \
      --debug-manifest android/app/src/debug/AndroidManifest.xml \
      --version-code "$expected_code" \
      --version-name "$expected_version" \
      --target-sdk "$expected_target"
    if [[ -n "${ANDROID_RELEASE_KEYSTORE_PATH:-}" ]]; then
      expected=$(tr -d "[:space:]" < trackglance-release-certificate.sha256)
      actual=$(apksigner verify --verbose --print-certs "$release_apk" |
        sed -n "s/^Signer #1 certificate SHA-256 digest: //p" |
        tr -d ":[:space:]" | tr "[:lower:]" "[:upper:]")
      test -n "$actual"
      test "$actual" = "$expected"
    fi
  '
}

release_artifacts() {
  local published=${1:-false} started
  [[ -n "${ANDROID_RELEASE_KEYSTORE_PATH:-}" ]] \
    || die "ANDROID_RELEASE_KEYSTORE_PATH is required for release-artifacts."
  [[ -n "${ANDROID_RELEASE_KEYSTORE_PASSWORD:-}" ]] \
    || die "ANDROID_RELEASE_KEYSTORE_PASSWORD is required for release-artifacts."
  if [[ "$published" == true ]]; then
    started=$SECONDS
    prepare_published_release_runner
    [[ -z "${GITHUB_STEP_SUMMARY:-}" ]] \
      || echo "- Published runner verification and pull: $((SECONDS - started))s" >> "$GITHUB_STEP_SUMMARY"
  else
    doctor_static
    static_image_exists || build_static_image
  fi
  started=$SECONDS
  run_static_container bash /workspace/tools/podman/release-artifacts.sh
  [[ -z "${GITHUB_STEP_SUMMARY:-}" ]] \
    || echo "- APK, PBW, and documentation compilation: $((SECONDS - started))s" >> "$GITHUB_STEP_SUMMARY"
}

development_command() {
  [[ $# -gt 0 ]] || die "dev requires a command"
  doctor_static
  static_image_exists || build_static_image
  run_static_container "$@"
}

run_android_tests() {
  local locus_dir=$1
  require_images
  require_current_golden "$locus_dir"
  ensure_cache_volumes
  new_run android
  ACTIVE_DATA_VOLUME="trackglance-${RUN_ID}-android"
  ACTIVE_RUNTIME_VOLUME="trackglance-${RUN_ID}-runtime"
  acceptance_engine volume create "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  clone_volume "$GOLDEN_VOLUME" "$ACTIVE_DATA_VOLUME"
  ACTIVE_POD="trackglance-${RUN_ID}"
  create_test_pod "$ACTIVE_POD"
  start_android "${ACTIVE_POD}-android" "$ACTIVE_DATA_VOLUME" "$ACTIVE_RUNTIME_VOLUME"
  set +e
  runner_in_pod "$RUN_ARTIFACTS" bash -euo pipefail -c '
    source /workspace/tools/podman/device-lib.sh
    capture_artifacts() {
      set +e
      adb_device_timeout 10 exec-out screencap -p > /artifacts/android-instrumentation.png
      adb_device_timeout 15 logcat -d > /artifacts/android-logcat.txt
      cp /workspace/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk /artifacts/
      cp /workspace/watchapp/build/watchapp.pbw /artifacts/
      cp -a /workspace/android/app/build/outputs/androidTest-results /artifacts/
      true
    }
    trap capture_artifacts EXIT
    wait_for_android 180
    adb_device uninstall app.trackglance.bridge >/dev/null 2>&1 || true
    grant_locus_test_permissions
    foreground_locus
    # Refresh the boot-time console fix after Locus is active. The emulator retains it until the
    # recording service registers its real GPS listener.
    set_emulator_test_location
    # AGP/ddmlib opens the emulator console while finalizing connected-test results. Give it the
    # same pod-private token used above; AGP 9.4 treats an unauthenticated console as a failed run.
    install -m 600 "$EMULATOR_CONSOLE_TOKEN" /root/.emulator_console_auth_token
    results=/workspace/android/app/build/outputs/androidTest-results/connected
    rm -rf "$results"
    set +e
    ANDROID_SERIAL="$ADB_SERIAL" timeout 30m ./gradlew :android:app:connectedDebugAndroidTest \
      -Pandroid.testInstrumentationRunnerArguments.runLocusIntegration=true
    gradle_status=$?
    set -e
    python3 /workspace/tools/podman/assert-instrumentation-results.py \
      "$results"
    if (( gradle_status != 0 )); then
      echo "AGP reported status $gradle_status despite complete passing instrumentation results; accepting the independently verified report." >&2
    fi
  '
  local status=$?
  acceptance_engine logs "${ACTIVE_POD}-android" \
    > "$RUN_ARTIFACTS/android-container.log" 2>&1 || true
  set -e
  stop_active_pod
  acceptance_engine volume rm --force "$ACTIVE_DATA_VOLUME" "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_DATA_VOLUME=
  ACTIVE_RUNTIME_VOLUME=
  return "$status"
}

run_e2e_platform() {
  local platform=$1 artifacts=$2
  ACTIVE_DATA_VOLUME="trackglance-${RUN_ID}-${platform}-android"
  ACTIVE_WATCH_VOLUME="trackglance-${RUN_ID}-${platform}-watch"
  ACTIVE_RUNTIME_VOLUME="trackglance-${RUN_ID}-${platform}-runtime"
  clone_volume "$GOLDEN_VOLUME" "$ACTIVE_DATA_VOLUME"
  acceptance_engine volume create "$ACTIVE_WATCH_VOLUME" >/dev/null
  acceptance_engine volume create "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_POD="trackglance-${RUN_ID}-${platform}"
  create_test_pod "$ACTIVE_POD"
  start_android "${ACTIVE_POD}-android" "$ACTIVE_DATA_VOLUME" "$ACTIVE_RUNTIME_VOLUME"
  local -a security network
  mapfile -t security < <(acceptance_security_args)
  mapfile -t network < <(active_network_args)
  acceptance_engine run --detach "${network[@]}" --name "${ACTIVE_POD}-watch" \
    "${security[@]}" \
    --env "PEBBLE_PLATFORM=$platform" --env "PEBBLE_SDK_VERSION=$PEBBLE_SDK_VERSION" \
    --volume "$PROJECT_DIR:/workspace" \
    --volume "$ACTIVE_WATCH_VOLUME:/pebble-state" \
    --volume "$ACTIVE_RUNTIME_VOLUME:/run/trackglance" \
    --volume "$artifacts:/artifacts" \
    --entrypoint /workspace/tools/podman/watch-qemu-entrypoint.sh \
    "$BUILD_IMAGE" >/dev/null
  register_active_container "${ACTIVE_POD}-watch"
  set +e
  runner_in_pod "$artifacts" env PEBBLE_PLATFORM="$platform" \
    bash /workspace/tools/podman/e2e-stage.sh
  local status=$?
  acceptance_engine logs "${ACTIVE_POD}-android" \
    > "$artifacts/${platform}-android-container.log" 2>&1 || true
  acceptance_engine logs "${ACTIVE_POD}-watch" \
    > "$artifacts/${platform}-watch-container.log" 2>&1 || true
  set -e
  stop_active_pod
  acceptance_engine volume rm --force \
    "$ACTIVE_DATA_VOLUME" "$ACTIVE_WATCH_VOLUME" "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_DATA_VOLUME=
  ACTIVE_WATCH_VOLUME=
  ACTIVE_RUNTIME_VOLUME=
  return "$status"
}

e2e_tests() {
  local locus_dir=$1
  require_images
  require_current_golden "$locus_dir"
  ensure_cache_volumes
  new_run e2e
  cp "$PROJECT_DIR/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk" "$RUN_ARTIFACTS/"
  cp "$PROJECT_DIR/watchapp/build/watchapp.pbw" "$RUN_ARTIFACTS/"
  run_e2e_platform emery "$RUN_ARTIFACTS"
  run_e2e_platform gabbro "$RUN_ARTIFACTS"
}

all_tests() {
  local locus_dir=$1
  static_tests
  run_android_tests "$locus_dir"
  e2e_tests "$locus_dir"
}

stage_acceptance_diagnostics() {
  local destination=$ACCEPTANCE_DIAGNOSTICS_ROOT file relative
  mkdir -p "$destination"
  [[ "$destination" == "$PROJECT_DIR/build/acceptance-diagnostics" ]] \
    || die "Refusing unexpected diagnostics path."
  find "$destination" -mindepth 1 -delete
  [[ -d "$BUILD_ROOT" ]] || return 0
  while IFS= read -r -d '' file; do
    relative=${file#"$BUILD_ROOT"/}
    mkdir -p "$destination/$(dirname "$relative")"
    cp "$file" "$destination/$relative"
  done < <(
    find "$BUILD_ROOT" \
      \( -path "$BUILD_ROOT/generated" -o -path '*/compose_metrics' \) -prune -o -type f \
      \( -name '*.log' -o -name '*.txt' -o -name '*.jsonl' -o -name '*.xml' \
         -o -name '*.png' -o -name '*.ppm' \) -print0
  )
  if find "$destination" -type f \
    \( -name '*.apk' -o -name '*.pbw' -o -name '*.p12' -o -name '*.keystore' \) \
    -print -quit | grep -q .; then
    die "A forbidden binary was staged as acceptance diagnostics."
  fi
}

report_acceptance_resources() {
  [[ "${ACCEPTANCE_REPORT_RESOURCES:-0}" == 1 ]] || return 0
  df -h "$PROJECT_DIR"
  acceptance_engine system df || true
  du -sh "$BUILD_ROOT" "$PROJECT_DIR/android/app/build" \
    "$PROJECT_DIR/watchapp/build" "$LOCUS_INPUT_DIR" 2>/dev/null || true
}

assert_no_active_acceptance_runtime() {
  local active
  if [[ "$ACCEPTANCE_ENGINE" == docker ]]; then
    active=$(docker container ls -a --format '{{.Names}}' --filter name=trackglance-)
  else
    active=$(podman pod ps --format '{{.Name}}' --filter 'name=^trackglance-')
  fi
  [[ -z "$active" ]] || {
    echo "Acceptance left active runtime resources:" >&2
    echo "$active" >&2
    return 1
  }
}

acceptance_suite() {
  local fresh=false published=false cleanup=false watch_passes=1 status cleanup_status pass
  local -a locus_options=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fresh)
        fresh=true
        shift
        ;;
      --published)
        fresh=true
        published=true
        shift
        ;;
      --cleanup)
        cleanup=true
        shift
        ;;
      --watch-passes)
        [[ $# -ge 2 ]] || die "--watch-passes requires 1 or 2"
        watch_passes=$2
        shift 2
        ;;
      --locus-apks)
        [[ $# -ge 2 ]] || die "--locus-apks requires a directory"
        locus_options=(--locus-apks "$2")
        shift 2
        ;;
      *) die "Unknown acceptance-suite option: $1" ;;
    esac
  done
  [[ "$watch_passes" == 1 || "$watch_passes" == 2 ]] \
    || die "--watch-passes must be 1 or 2"
  parse_locus_apk_options "${locus_options[@]}"
  local locus_dir=$LOCUS_INPUT_DIR
  export LOCUS_APKS_DIR=$locus_dir
  [[ "$cleanup" == true ]] && SUITE_CLEANUP_ON_EXIT=true

  set +e
  (
    set -e
    if [[ "$published" == true ]]; then
      clean
      prepare_published_acceptance_images
      ACCEPTANCE_BOOTSTRAP_AUTOMATED=1 bootstrap --locus-apks "$locus_dir"
    elif [[ "$fresh" == true ]]; then
      clean
      build_acceptance_all
      ACCEPTANCE_BOOTSTRAP_AUTOMATED=1 bootstrap --locus-apks "$locus_dir"
    else
      doctor_acceptance
    fi
    report_acceptance_resources
    run_android_tests "$locus_dir"
    assert_no_active_acceptance_runtime
    report_acceptance_resources
    for ((pass=1; pass <= watch_passes; pass++)); do
      echo "Running Emery and Gabbro acceptance pass $pass of $watch_passes."
      e2e_tests "$locus_dir"
      assert_no_active_acceptance_runtime
      report_acceptance_resources
    done
  )
  status=$?
  set -e

  if (( status != 0 )); then
    stage_acceptance_diagnostics
  fi
  if [[ "$cleanup" == true ]]; then
    SUITE_CLEANUP_ON_EXIT=false
    set +e
    clean
    cleanup_status=$?
    set -e
    (( status != 0 )) || status=$cleanup_status
  fi
  return "$status"
}

clean() {
  select_acceptance_engine
  local pod container volume image cleanup_image='' cleanup_status=0
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    while read -r pod; do
      [[ "$pod" == trackglance-* ]] && podman pod rm --force "$pod" >/dev/null
    done < <(podman pod ps --format '{{.Name}}' --filter 'name=^trackglance-')
  else
    while read -r container; do
      [[ "$container" == trackglance-* ]] \
        && docker container rm --force "$container" >/dev/null
    done < <(docker container ls -a --format '{{.Names}}' --filter name=trackglance-)
  fi
  while read -r volume; do
    [[ "$volume" == trackglance-* ]] \
      && acceptance_engine volume rm --force "$volume" >/dev/null
  done < <(acceptance_engine volume ls --format '{{.Name}}' --filter name=trackglance-)
  if [[ -d "$BUILD_ROOT" ]]; then
    [[ "$BUILD_ROOT" == "$PROJECT_DIR/build/podman" ]] || die "Refusing unexpected clean path."
    if [[ "$ACCEPTANCE_ENGINE" == docker ]]; then
      if acceptance_image_exists "$GENERATOR_IMAGE"; then
        cleanup_image=$GENERATOR_IMAGE
      elif [[ "$ACCEPTANCE_RUNNER_IMAGE" != UNPUBLISHED ]] \
        && acceptance_image_exists "$ACCEPTANCE_RUNNER_IMAGE"; then
        # BUILD_IMAGE is changed only inside the acceptance-suite provisioning subshell. Refer to
        # the immutable runner pin directly so the outer cleanup can still remove Docker-owned
        # workspace files after that subshell exits.
        cleanup_image=$ACCEPTANCE_RUNNER_IMAGE
      elif acceptance_image_exists "$BUILD_IMAGE"; then
        # Published acceptance deliberately has no source-built generator image. Its runner may
        # create root-owned files in the bind-mounted workspace, so clean them in a container too.
        cleanup_image=$BUILD_IMAGE
      fi
    fi
    if [[ -n "$cleanup_image" ]]; then
      docker run --rm --volume "$BUILD_ROOT:/target" "$cleanup_image" \
        find /target -mindepth 1 -delete || cleanup_status=$?
      if (( cleanup_status == 0 )); then
        rmdir "$BUILD_ROOT" || cleanup_status=$?
      fi
    else
      find "$BUILD_ROOT" -depth -delete || cleanup_status=$?
    fi
  fi
  for image in \
    "$EMULATOR_IMAGE" "$GENERATED_EMULATOR_IMAGE" "$GENERATED_EMULATOR_LATEST" \
    "$GENERATED_EMULATOR_BARE" "$GENERATED_SYSTEM_IMAGE" "$GENERATED_SYSTEM_IMAGE_BARE" \
    "$WEB_IMAGE" "$GENERATOR_IMAGE" "$BUILD_IMAGE" \
    "$ACCEPTANCE_RUNNER_IMAGE" "$ACCEPTANCE_EMULATOR_IMAGE"; do
    [[ "$image" != UNPUBLISHED ]] || continue
    acceptance_image_exists "$image" \
      && acceptance_engine image rm --force "$image" >/dev/null || true
  done
  acceptance_network_exists "$NETWORK" \
    && acceptance_engine network rm "$NETWORK" >/dev/null || true
  echo "Removed acceptance images, volumes, containers, network, caches, and generated artifacts."
  return "$cleanup_status"
}

main() {
  local command=${1:-}
  [[ -n "$command" ]] || { usage; return 2; }
  shift
  case "$command" in
    doctor) [[ $# -eq 1 ]] || die "doctor requires static or acceptance"; doctor "$1" ;;
    build)
      if [[ $# -eq 1 && "$1" == --refresh ]]; then
        PULL_POLICY=always
      elif [[ $# -ne 0 ]]; then
        die "build accepts only --refresh"
      fi
      build_all
      ;;
    build-acceptance)
      if [[ $# -eq 1 && "$1" == --refresh ]]; then
        PULL_POLICY=always
      elif [[ $# -ne 0 ]]; then
        die "build-acceptance accepts only --refresh"
      fi
      build_acceptance_all
      ;;
    build-static)
      doctor_static
      if [[ $# -eq 1 && "$1" == --refresh ]]; then
        PULL_POLICY=always
      elif [[ $# -ne 0 ]]; then
        die "build-static accepts only --refresh"
      fi
      build_static_image
      ;;
    dev) development_command "$@" ;;
    bootstrap) bootstrap "$@" ;;
    manual) manual_lab "$@" ;;
    static) [[ $# -eq 0 ]] || die "static takes no options"; static_tests ;;
    documentation) [[ $# -eq 0 ]] || die "documentation takes no options"; documentation_tests ;;
    release-check) [[ $# -eq 0 ]] || die "release-check takes no options"; release_check ;;
    release-artifacts)
      if [[ $# -eq 0 ]]; then
        release_artifacts false
      elif [[ $# -eq 1 && "$1" == --published ]]; then
        release_artifacts true
      else
        die "release-artifacts accepts only --published"
      fi
      ;;
    android) parse_locus_apk_options "$@"; run_android_tests "$LOCUS_INPUT_DIR" ;;
    acceptance|e2e) parse_locus_apk_options "$@"; e2e_tests "$LOCUS_INPUT_DIR" ;;
    acceptance-suite) acceptance_suite "$@" ;;
    all) parse_locus_apk_options "$@"; all_tests "$LOCUS_INPUT_DIR" ;;
    clean) [[ $# -eq 0 ]] || die "clean takes no options"; clean ;;
    -h|--help|help) usage ;;
    *) usage; die "Unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
