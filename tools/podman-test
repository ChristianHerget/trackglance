manual_lab() {
  parse_manual_options "$@"
  local platform=$MANUAL_PLATFORM locus_dir=$LOCUS_INPUT_DIR
  doctor_acceptance
  require_manual_images
  require_current_golden "$locus_dir"
  ensure_cache_volumes

  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$-manual"
  RUN_ARTIFACTS="$BUILD_ROOT/$RUN_ID"
  mkdir -p "$RUN_ARTIFACTS"
  MANUAL_ARTIFACTS=$RUN_ARTIFACTS
  MANUAL_GOLDEN_MARKER=$(golden_marker) \
    || die "Could not snapshot the golden-state marker before the manual session."
  ACTIVE_DATA_VOLUME="trackglance-${RUN_ID}-android"
  ACTIVE_WATCH_VOLUME="trackglance-${RUN_ID}-watch"
  ACTIVE_RUNTIME_VOLUME="trackglance-${RUN_ID}-runtime"
  clone_volume "$GOLDEN_VOLUME" "$ACTIVE_DATA_VOLUME"
  acceptance_engine volume create "$ACTIVE_WATCH_VOLUME" >/dev/null
  acceptance_engine volume create "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_POD="trackglance-${RUN_ID}"
  if ! create_test_pod "$ACTIVE_POD" true; then
    die "Could not create the manual lab on 127.0.0.1:5173; stop the previous lab and retry."
  fi
  start_android "${ACTIVE_POD}-android" "$ACTIVE_DATA_VOLUME" "$ACTIVE_RUNTIME_VOLUME"
  start_manual_watch "$platform"
  start_manual_controller "$platform"
  start_manual_web

  local controller="${ACTIVE_POD}-manual" deadline=$((SECONDS + 300)) state
  while (( SECONDS < deadline )); do
    state=$(acceptance_engine inspect --format '{{.State.Status}}' "$controller" 2>/dev/null || true)
    [[ "$state" != exited && "$state" != dead ]] \
      || die "Manual-lab initialization failed; diagnostics are being retained in $MANUAL_ARTIFACTS."
    if acceptance_engine exec "$controller" test -s /run/trackglance/manual-ready 2>/dev/null \
      && acceptance_engine exec "$controller" python3 -c \
        'import socket; socket.create_connection(("127.0.0.1", 8081), 2).close()' 2>/dev/null; then
      break
    fi
    sleep 1
  done
  (( SECONDS < deadline )) \
    || die "Manual lab did not become ready within 300 seconds; diagnostics are being retained."

  echo "Manual $platform lab is ready at http://127.0.0.1:5173/."
  echo "Locus recording is stopped. Captures and bounded logs are stored in $MANUAL_ARTIFACTS."
  echo "Press Ctrl-C to collect diagnostics and remove this disposable session."

  while [[ "$(acceptance_engine inspect --format '{{.State.Running}}' "$controller" 2>/dev/null || true)" == true ]]; do
    sleep 2
  done
  collect_manual_artifacts
  cleanup_active
  echo "Manual lab stopped; disposable containers and volumes were removed."
  return 1
}

static_tests() {
  doctor_static
  static_image_exists || build_static_image
  new_run static
  set +e
  run_static_container bash -euo pipefail -c '
    mkdir -p "$HOME"
    bash -n tools/podman-test tools/podman/*.sh docs/*.sh
    actionlint .github/workflows/*.yml
    shellcheck --severity=warning tools/podman-test tools/format tools/check-format tools/check-c tools/podman/*.sh docs/*.sh
    ruff check tools
    python3 -m unittest discover -s tools/podman -p "test_*.py"
    python3 tools/validate-appstore-kit.py
    version_check=$(./tools/bump-version --check)
    echo "$version_check"
    tools/release-notes "${version_check##* }" >/dev/null
    ./tools/check-format
    ./tools/check-c
    ./gradlew verifyPebbleTargets :android:app:testDebugUnitTest :android:app:lintDebug :android:app:detekt \
      :android:app:assembleDebug :android:app:compileDebugAndroidTestKotlin
    npm ci --prefix watchapp
    npm test --prefix watchapp
    npm run lint --prefix watchapp
    (cd watchapp && pebble clean && pebble build && npm run verify:pbw)
  ' 2>&1 | tee "$RUN_ARTIFACTS/static.log"
  local status=${PIPESTATUS[0]}
  set -e
  [[ ! -s "$PROJECT_DIR/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk" ]] \
    || cp "$PROJECT_DIR/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk" "$RUN_ARTIFACTS/"
  [[ ! -s "$PROJECT_DIR/watchapp/build/watchapp.pbw" ]] \
    || cp "$PROJECT_DIR/watchapp/build/watchapp.pbw" "$RUN_ARTIFACTS/"
  [[ ! -d "$PROJECT_DIR/docs/sphinx/_build/html" ]] \
    || cp -a "$PROJECT_DIR/docs/sphinx/_build/html" "$RUN_ARTIFACTS/html"
  return "$status"
}

