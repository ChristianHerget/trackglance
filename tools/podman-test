#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
source "$SCRIPT_DIR/podman/versions.env"
source "$SCRIPT_DIR/podman/release-metadata.sh"
source "$SCRIPT_DIR/ci-images.env"
load_release_metadata "$PROJECT_DIR"

BUILD_ROOT="$PROJECT_DIR/build/podman"
IMAGE_PREFIX=localhost/trackglance
BUILD_IMAGE="$IMAGE_PREFIX/build:$RELEASE_VERSION"
GENERATOR_IMAGE="$IMAGE_PREFIX/emulator-generator:$ANDROID_EMULATOR_SCRIPTS_COMMIT"
GENERATED_EMULATOR_IMAGE="$IMAGE_PREFIX/android-api32-generated:15917651"
GENERATED_EMULATOR_LATEST="$IMAGE_PREFIX/android-api32-generated:latest"
GENERATED_EMULATOR_BARE=android-api32-generated:latest
GENERATED_SYSTEM_IMAGE="$IMAGE_PREFIX/sys-32-google-x64:latest"
GENERATED_SYSTEM_IMAGE_BARE=sys-32-google-x64:latest
EMULATOR_IMAGE="$IMAGE_PREFIX/android-api32:$ANDROID_EMULATOR_VERSION"
WEB_IMAGE="$IMAGE_PREFIX/android-webrtc:$ANDROID_EMULATOR_SCRIPTS_COMMIT"
NETWORK=trackglance-test
GOLDEN_VOLUME=trackglance-android-api32-golden
DOWNLOAD_VOLUME=trackglance-android-downloads
GRADLE_CACHE=trackglance-gradle-cache
NPM_CACHE=trackglance-npm-cache
BOOTSTRAP_SCHEMA=4
LOCUS_FIXTURE_CONFIG="$SCRIPT_DIR/locus-test-apk.properties"
ACTIVE_POD=
ACTIVE_ANDROID_CONTAINER=
ACTIVE_PUBLISH_WEBRTC=false
ACTIVE_CONTAINERS=()
ACTIVE_DATA_VOLUME=
ACTIVE_WATCH_VOLUME=
ACTIVE_RUNTIME_VOLUME=
SERVICE_PID=
SOCKET_DIR=
LOCUS_INPUT_DIR=
ACCEPTANCE_DIAGNOSTICS_ROOT="$PROJECT_DIR/build/acceptance-diagnostics"
SUITE_CLEANUP_ON_EXIT=false
MANUAL_ARTIFACTS=
MANUAL_GOLDEN_MARKER=
MANUAL_PLATFORM=
MANUAL_COLLECTED=false
PULL_POLICY=missing
STATIC_ENGINE=
ACCEPTANCE_ENGINE=
CI_IMAGE_SIGNER_WORKFLOW="$CI_IMAGE_SOURCE_REPOSITORY/.github/workflows/publish-ci-images.yml@refs/heads/main"

usage() {
  cat <<'EOF'
Usage: ./tools/podman-test COMMAND [OPTIONS]

Commands:
  doctor static                  Validate only prerequisites for static checks
  doctor acceptance              Validate the complete rootless x86_64/KVM host
  build-static [--refresh]       Build only the version-pinned development image
  dev COMMAND [ARGUMENTS...]     Run an arbitrary command in the development container
  build [--refresh]              Build pinned images; refresh explicitly pulls pinned inputs
  build-acceptance              Build only images and artifacts required by headless acceptance
  bootstrap --locus-apks DIR     Create the onboarded API 32 golden state
  manual --platform PLATFORM     Start a disposable Android/Pebble manual-test lab
  static                         Run every public check inside the development container
  documentation                  Validate committed documentation in the development container
  release-check                  Assemble release and enforce the compiled APK security policy
  release-artifacts [--published]
                                 Build and validate only distributable APK, PBW, and documentation
  android --locus-apks DIR       Run every instrumentation test, including Locus
  acceptance --locus-apks DIR    Run Emery acceptance and Gabbro smoke automation
  acceptance-suite [OPTIONS]     Run Android plus Emery/Gabbro acceptance from warm or fresh state
  all --locus-apks DIR           Run static, android, and e2e in order
  clean                          Remove this workflow's generated state and images

LOCUS_APKS_DIR may be used instead of --locus-apks.
PLATFORM for manual must be emery or gabbro; only 127.0.0.1:5173 is published.
Use acceptance-suite --published to provision from the verified, digest-pinned GHCR image set.
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

cleanup_active() {
  set +e
  collect_manual_artifacts
  if [[ "$ACCEPTANCE_ENGINE" == docker ]]; then
    local container index
    for ((index=${#ACTIVE_CONTAINERS[@]} - 1; index >= 0; index--)); do
      container=${ACTIVE_CONTAINERS[$index]}
      [[ -z "$container" ]] || docker rm --force "$container" >/dev/null 2>&1
    done
  elif [[ -n "$ACTIVE_POD" ]]; then
    podman pod stop --time 15 "$ACTIVE_POD" >/dev/null 2>&1
    podman pod rm --force "$ACTIVE_POD" >/dev/null 2>&1
  fi
  for volume in "$ACTIVE_DATA_VOLUME" "$ACTIVE_WATCH_VOLUME" "$ACTIVE_RUNTIME_VOLUME"; do
    [[ -z "$volume" || -z "$ACCEPTANCE_ENGINE" ]] \
      || "$ACCEPTANCE_ENGINE" volume rm --force "$volume" >/dev/null 2>&1
  done
  if [[ -n "$SERVICE_PID" ]]; then
    kill "$SERVICE_PID" >/dev/null 2>&1
    wait "$SERVICE_PID" >/dev/null 2>&1
  fi
  if [[ -n "$SOCKET_DIR" && -d "$SOCKET_DIR" ]]; then
    find "$SOCKET_DIR" -mindepth 1 -delete >/dev/null 2>&1
    rmdir "$SOCKET_DIR" >/dev/null 2>&1
  fi
  if [[ -n "$MANUAL_GOLDEN_MARKER" && -n "$ACCEPTANCE_ENGINE" ]]; then
    local current_golden_marker
    current_golden_marker=$(golden_marker 2>/dev/null)
    if [[ "$current_golden_marker" != "$MANUAL_GOLDEN_MARKER" ]]; then
      echo "Error: Manual-lab cleanup could not verify the original golden-state marker." >&2
    fi
  fi
  ACTIVE_POD=
  ACTIVE_ANDROID_CONTAINER=
  ACTIVE_PUBLISH_WEBRTC=false
  ACTIVE_CONTAINERS=()
  ACTIVE_DATA_VOLUME=
  ACTIVE_WATCH_VOLUME=
  ACTIVE_RUNTIME_VOLUME=
  SERVICE_PID=
  SOCKET_DIR=
  MANUAL_ARTIFACTS=
  MANUAL_GOLDEN_MARKER=
  MANUAL_PLATFORM=
  MANUAL_COLLECTED=false
  if [[ "$SUITE_CLEANUP_ON_EXIT" == true ]]; then
    stage_acceptance_diagnostics
    SUITE_CLEANUP_ON_EXIT=false
    clean
  fi
  set -e
}
trap cleanup_active EXIT INT TERM HUP

select_acceptance_engine() {
  [[ -z "$ACCEPTANCE_ENGINE" ]] || return 0
  if [[ -n "${ACCEPTANCE_CONTAINER_ENGINE:-}" ]]; then
    ACCEPTANCE_ENGINE=$ACCEPTANCE_CONTAINER_ENGINE
  elif command -v podman >/dev/null; then
    ACCEPTANCE_ENGINE=podman
  elif command -v docker >/dev/null; then
    ACCEPTANCE_ENGINE=docker
  else
    die "Install Docker or rootless Podman for acceptance."
  fi
  [[ "$ACCEPTANCE_ENGINE" == podman || "$ACCEPTANCE_ENGINE" == docker ]] \
    || die "ACCEPTANCE_CONTAINER_ENGINE must be docker or podman."
  command -v "$ACCEPTANCE_ENGINE" >/dev/null \
    || die "$ACCEPTANCE_ENGINE is not installed."
}

acceptance_engine() {
  select_acceptance_engine
  "$ACCEPTANCE_ENGINE" "$@"
}

acceptance_image_exists() {
  select_acceptance_engine
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    podman image exists "$1" 2>/dev/null
  else
    docker image inspect "$1" >/dev/null 2>&1
  fi
}

acceptance_image_label() {
  local image=$1 label=$2
  select_acceptance_engine
  "$ACCEPTANCE_ENGINE" image inspect --format "{{ index .Config.Labels \"$label\" }}" "$image" 2>/dev/null
}

acceptance_volume_exists() {
  select_acceptance_engine
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    podman volume exists "$1" 2>/dev/null
  else
    docker volume inspect "$1" >/dev/null 2>&1
  fi
}

acceptance_network_exists() {
  select_acceptance_engine
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    podman network exists "$1" 2>/dev/null
  else
    docker network inspect "$1" >/dev/null 2>&1
  fi
}

acceptance_security_args() {
  select_acceptance_engine
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    printf '%s\n' --group-add keep-groups --security-opt label=disable
  fi
}

active_network_args() {
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    printf '%s\n' --pod "$ACTIVE_POD"
  else
    printf '%s\n' --network "container:$ACTIVE_ANDROID_CONTAINER"
  fi
}

register_active_container() {
  [[ "$ACCEPTANCE_ENGINE" != docker ]] || ACTIVE_CONTAINERS+=("$1")
}

podman_build() {
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    podman build --pull="$PULL_POLICY" "$@"
  elif [[ "$PULL_POLICY" == always ]]; then
    docker build --pull "$@"
  else
    docker build "$@"
  fi
}

ensure_network() {
  acceptance_network_exists "$NETWORK" || acceptance_engine network create "$NETWORK" >/dev/null
}

ensure_cache_volumes() {
  for volume in "$GRADLE_CACHE" "$NPM_CACHE"; do
    acceptance_volume_exists "$volume" || acceptance_engine volume create "$volume" >/dev/null
  done
}

build_container_args() {
  local -a security
  mapfile -t security < <(acceptance_security_args)
  printf '%s\n' --rm "${security[@]}" \
    --volume "$PROJECT_DIR:/workspace" \
    --volume "$GRADLE_CACHE:/root/.gradle" \
    --volume "$NPM_CACHE:/root/.npm" \
    --workdir /workspace
  if [[ -n "${ANDROID_RELEASE_KEYSTORE_PATH:-}" ]]; then
    printf '%s\n' \
      --env ANDROID_RELEASE_KEYSTORE_PATH=/run/trackglance-release.p12 \
      --env ANDROID_RELEASE_KEYSTORE_PASSWORD \
      --volume "$ANDROID_RELEASE_KEYSTORE_PATH:/run/trackglance-release.p12:ro"
  fi
}

run_build_container() {
  local -a arguments
  mapfile -t arguments < <(build_container_args)
  acceptance_engine run "${arguments[@]}" "$BUILD_IMAGE" "$@"
}

select_static_engine() {
  if [[ -n "${DEV_CONTAINER_ENGINE:-}" ]]; then
    command -v "$DEV_CONTAINER_ENGINE" >/dev/null ||
      die "DEV_CONTAINER_ENGINE '$DEV_CONTAINER_ENGINE' is not installed."
    STATIC_ENGINE=$DEV_CONTAINER_ENGINE
  elif command -v docker >/dev/null; then
    STATIC_ENGINE=docker
  elif command -v podman >/dev/null; then
    STATIC_ENGINE=podman
  else
    die "Install Docker or rootless Podman; development dependencies stay inside the container."
  fi
}

doctor_static() {
  select_static_engine
  if [[ "$STATIC_ENGINE" == podman ]]; then
    [[ "$(podman info --format '{{.Host.Security.Rootless}}')" == true ]] ||
      die "The development container requires rootless Podman."
  fi
  echo "Container engine is ready: $STATIC_ENGINE. KVM, emulator images, and Locus APKs are not required."
}

doctor_acceptance() {
  select_acceptance_engine
  [[ "$(uname -s)" == Linux ]] || die "Acceptance requires Linux."
  [[ "$(uname -m)" == x86_64 ]] || die "Acceptance requires x86_64."
  [[ $(id -u) -ne 0 ]] || die "Run the workflow as a normal user, not root."
  local version cpus memory_kib free_kib
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    local rootless runtime
    rootless=$(podman info --format '{{.Host.Security.Rootless}}')
    [[ "$rootless" == true ]] || die "Podman must be rootless."
    version=$(podman version --format '{{.Client.Version}}')
    [[ "$(printf '%s\n' 4.4.0 "$version" | sort -V | head -n1)" == 4.4.0 ]] \
      || die "Podman 4.4.0 or newer is required (found $version)."
    runtime=$(podman info --format '{{.Host.OCIRuntime.Name}}')
    [[ "$runtime" == crun ]] \
      || die "Podman's crun OCI runtime is required for --group-add keep-groups."
  else
    docker info >/dev/null || die "The current user cannot use the Docker daemon."
    version=$(docker version --format '{{.Client.Version}}')
    [[ "$(printf '%s\n' 24.0.0 "$version" | sort -V | head -n1)" == 24.0.0 ]] \
      || die "Docker 24.0.0 or newer is required (found $version)."
  fi
  [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || die "The current user cannot access /dev/kvm."
  cpus=$(getconf _NPROCESSORS_ONLN)
  (( cpus >= 4 )) || die "At least four logical CPUs are required (found $cpus)."
  memory_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  (( memory_kib >= 8 * 1024 * 1024 )) || die "At least 8 GiB RAM is required."
  free_kib=$(df -Pk "$PROJECT_DIR" | awk 'NR==2 {print $4}')
  (( free_kib >= 35 * 1024 * 1024 )) || die "At least 35 GiB free disk is required."
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    echo "Host is ready: rootless Podman $version with crun, KVM, $cpus CPUs, sufficient RAM and disk."
  else
    echo "Host is ready: Docker $version with KVM, $cpus CPUs, sufficient RAM and disk."
  fi
  report_acceptance_provisioning
}

report_acceptance_provisioning() {
  local image missing_images=0
  for image in "$BUILD_IMAGE" "$EMULATOR_IMAGE" "$WEB_IMAGE"; do
    if ! acceptance_image_exists "$image"; then
      missing_images=$((missing_images + 1))
    fi
  done
  if (( missing_images == 0 )); then
    echo "Acceptance images: ready."
  else
    echo "Acceptance images: $missing_images missing; run ./tools/podman-test build."
  fi

  if [[ -n "${LOCUS_APKS_DIR:-}" && -d "$LOCUS_APKS_DIR" ]]; then
    echo "Locus fixture input: configured outside the repository."
  else
    echo "Locus fixture input: not configured; set LOCUS_APKS_DIR to an absolute directory."
  fi

  if acceptance_volume_exists "$GOLDEN_VOLUME"; then
    echo "Golden Android state: ready."
  else
    echo "Golden Android state: missing; run bootstrap after the images and Locus fixture are ready."
  fi
}

doctor() {
  case "${1:-}" in
    static) doctor_static ;;
    acceptance) doctor_acceptance ;;
    *) die "doctor requires either 'static' or 'acceptance'." ;;
  esac
}

build_emulator_image() {
  mkdir -p "$BUILD_ROOT/generated"
  acceptance_volume_exists "$DOWNLOAD_VOLUME" \
    || acceptance_engine volume create "$DOWNLOAD_VOLUME" >/dev/null
  local socket
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    SOCKET_DIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/trackglance-podman.XXXXXX")
    socket="$SOCKET_DIR/docker.sock"
    podman system service --time=0 "unix://$socket" >"$BUILD_ROOT/podman-service.log" 2>&1 &
    SERVICE_PID=$!
    for _ in $(seq 1 100); do
      [[ -S "$socket" ]] && break
      kill -0 "$SERVICE_PID" 2>/dev/null \
        || die "Podman's temporary Docker-compatible service exited."
      sleep 0.1
    done
    [[ -S "$socket" ]] \
      || die "Podman's temporary Docker-compatible socket did not become ready."
  else
    socket=/var/run/docker.sock
    [[ -S "$socket" ]] || die "Docker's daemon socket is unavailable."
  fi

  local -a security
  mapfile -t security < <(acceptance_security_args)
  set +e
  acceptance_engine run --rm "${security[@]}" \
    --env DOCKER_HOST=unix:///run/docker.sock \
    --env ANDROID_EMULATOR_URL="$ANDROID_EMULATOR_URL" \
    --env ANDROID_EMULATOR_SHA256="$ANDROID_EMULATOR_SHA256" \
    --env ANDROID_SYSTEM_IMAGE_URL="$ANDROID_SYSTEM_IMAGE_URL" \
    --env ANDROID_SYSTEM_IMAGE_SHA256="$ANDROID_SYSTEM_IMAGE_SHA256" \
    --volume "$socket:/run/docker.sock" \
    --volume "$DOWNLOAD_VOLUME:/downloads" \
    --volume "$BUILD_ROOT/generated:/generated" \
    "$GENERATOR_IMAGE" bash -euo pipefail -c '
      emulator_zip=/downloads/emulator-linux_x64-15917651.zip
      system_zip=/downloads/x86_64-32_r08.zip
      echo "$ANDROID_EMULATOR_SHA256  $emulator_zip" | sha256sum --check --strict >/dev/null 2>&1 \
        || curl --fail --location --retry 4 --retry-all-errors --retry-delay 2 \
          --continue-at - "$ANDROID_EMULATOR_URL" --output "$emulator_zip"
      echo "$ANDROID_SYSTEM_IMAGE_SHA256  $system_zip" | sha256sum --check --strict >/dev/null 2>&1 \
        || curl --fail --location --retry 4 --retry-all-errors --retry-delay 2 \
          --continue-at - "$ANDROID_SYSTEM_IMAGE_URL" --output "$system_zip"
      echo "$ANDROID_EMULATOR_SHA256  $emulator_zip" | sha256sum --check --strict
      echo "$ANDROID_SYSTEM_IMAGE_SHA256  $system_zip" | sha256sum --check --strict
      emu-docker create "$emulator_zip" "$system_zip" \
        --dest /generated --repo localhost/trackglance \
        --name android-api32-generated --no-metrics
    '
  local status=$?
  set -e
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    kill "$SERVICE_PID" >/dev/null 2>&1
    wait "$SERVICE_PID" >/dev/null 2>&1
    SERVICE_PID=
    find "$SOCKET_DIR" -mindepth 1 -delete
    rmdir "$SOCKET_DIR"
    SOCKET_DIR=
  fi
  (( status == 0 )) || return "$status"
  if ! acceptance_image_exists "$GENERATED_EMULATOR_IMAGE"; then
    acceptance_image_exists "$GENERATED_EMULATOR_LATEST" \
      || die "Google's generator did not produce the expected image."
    acceptance_engine tag "$GENERATED_EMULATOR_LATEST" "$GENERATED_EMULATOR_IMAGE"
  fi

  podman_build \
    --build-arg "GENERATED_IMAGE=$GENERATED_EMULATOR_IMAGE" \
    --file "$SCRIPT_DIR/podman/Containerfile.emulator" \
    --tag "$EMULATOR_IMAGE" "$PROJECT_DIR"
}

build_static_image() {
  [[ -n "$STATIC_ENGINE" ]] || select_static_engine
  local -a pull=()
  if [[ "$STATIC_ENGINE" == podman ]]; then
    pull=("--pull=$PULL_POLICY")
  elif [[ "$PULL_POLICY" == always ]]; then
    pull=(--pull)
  fi
  "$STATIC_ENGINE" build "${pull[@]}" \
    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
    --build-arg "ANDROID_CMDLINE_TOOLS_VERSION=$ANDROID_CMDLINE_TOOLS_VERSION" \
    --build-arg "ANDROID_CMDLINE_TOOLS_SHA256=$ANDROID_CMDLINE_TOOLS_SHA256" \
    --build-arg "ANDROID_PLATFORM_TOOLS_VERSION=$ANDROID_PLATFORM_TOOLS_VERSION" \
    --build-arg "ANDROID_PLATFORM_32_REVISION=$ANDROID_PLATFORM_32_REVISION" \
    --build-arg "ANDROID_PLATFORM_36_REVISION=$ANDROID_PLATFORM_36_REVISION" \
    --build-arg "ANDROID_PLATFORM_37_REVISION=$ANDROID_PLATFORM_37_REVISION" \
    --build-arg "ANDROID_BUILD_TOOLS_VERSION=$ANDROID_BUILD_TOOLS_VERSION" \
    --build-arg "ANDROID_NDK_VERSION=$ANDROID_NDK_VERSION" \
    --build-arg "ANDROID_CMAKE_VERSION=$ANDROID_CMAKE_VERSION" \
    --build-arg "PEBBLE_TOOL_VERSION=$PEBBLE_TOOL_VERSION" \
    --build-arg "PEBBLE_SDK_VERSION=$PEBBLE_SDK_VERSION" \
    --build-arg "UV_VERSION=$UV_VERSION" \
    --build-arg "UV_X86_64_SHA256=$UV_X86_64_SHA256" \
    --build-arg "NODE_VERSION=$NODE_VERSION" \
    --build-arg "NODE_X86_64_SHA256=$NODE_X86_64_SHA256" \
    --build-arg "ACTIONLINT_VERSION=$ACTIONLINT_VERSION" \
    --build-arg "ACTIONLINT_X86_64_SHA256=$ACTIONLINT_X86_64_SHA256" \
    --file "$SCRIPT_DIR/podman/Containerfile.build" \
    --tag "$BUILD_IMAGE" "$PROJECT_DIR"
}

build_images() {
  local include_web=${1:-true}
  mkdir -p "$BUILD_ROOT/images"
  STATIC_ENGINE=$ACCEPTANCE_ENGINE build_static_image
  podman_build \
    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
    --build-arg "ANDROID_EMULATOR_SCRIPTS_COMMIT=$ANDROID_EMULATOR_SCRIPTS_COMMIT" \
    --file "$SCRIPT_DIR/podman/Containerfile.generator" \
    --tag "$GENERATOR_IMAGE" "$PROJECT_DIR"
  if [[ "$include_web" == true ]]; then
    podman_build \
      --build-arg "BASE_IMAGE=$BASE_IMAGE" \
      --build-arg "ANDROID_EMULATOR_SCRIPTS_COMMIT=$ANDROID_EMULATOR_SCRIPTS_COMMIT" \
      --build-arg "AEMU_PROTOS_COMMIT=$AEMU_PROTOS_COMMIT" \
      --file "$SCRIPT_DIR/podman/Containerfile.web" \
      --tag "$WEB_IMAGE" "$PROJECT_DIR"
  fi
  build_emulator_image
}

static_image_exists() {
  if [[ "$STATIC_ENGINE" == podman ]]; then
    podman image exists "$BUILD_IMAGE" 2>/dev/null
  else
    docker image inspect "$BUILD_IMAGE" >/dev/null 2>&1
  fi
}

run_static_container() {
  if [[ "$STATIC_ENGINE" == podman ]]; then
    ensure_cache_volumes
    run_build_container "$@"
    return
  fi
  local cache_root="$PROJECT_DIR/build/dev-container-cache"
  local -a signing_args=()
  if [[ -n "${ANDROID_RELEASE_KEYSTORE_PATH:-}" ]]; then
    signing_args=(
      --env ANDROID_RELEASE_KEYSTORE_PATH=/run/trackglance-release.p12
      --env ANDROID_RELEASE_KEYSTORE_PASSWORD
      --volume "$ANDROID_RELEASE_KEYSTORE_PATH:/run/trackglance-release.p12:ro"
    )
  fi
  mkdir -p "$cache_root/gradle" "$cache_root/npm"
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env HOME=/tmp \
    --env GRADLE_USER_HOME=/workspace/build/dev-container-cache/gradle \
    --env npm_config_cache=/workspace/build/dev-container-cache/npm \
    "${signing_args[@]}" \
    --volume "$PROJECT_DIR:/workspace" \
    --workdir /workspace \
    "$BUILD_IMAGE" "$@"
}

build_project_inputs() {
  local run_checks=${1:-true}
  local build_core_app=${2:-true}
  ensure_cache_volumes
  if [[ "$run_checks" == true ]]; then
    run_build_container bash -euo pipefail -c '
      ./gradlew verifyPebbleTargets \
        :android:app:testDebugUnitTest :android:app:assembleDebug \
        :android:app:assembleDebugAndroidTest
      npm ci --prefix watchapp
      npm test --prefix watchapp
      (cd watchapp && pebble clean && pebble build && npm run verify:pbw)
      npm ci --prefix docs
    '
  else
    run_build_container bash -euo pipefail -c '
      ./gradlew :android:app:assembleDebug :android:app:assembleDebugAndroidTest
      npm ci --prefix watchapp
      (cd watchapp && pebble clean && pebble build && npm run verify:pbw)
    '
  fi
  if [[ "$build_core_app" == true ]]; then
    run_build_container env CORE_APP_COMMIT="$CORE_APP_COMMIT" \
      bash /workspace/tools/podman/build-coreapp.sh /workspace
  fi
}

build_all() {
  doctor_acceptance
  ensure_network
  build_images
  build_project_inputs
  echo "Pinned acceptance images and provisioning artifacts are ready."
}

build_acceptance_all() {
  doctor_acceptance
  ensure_network
  build_images false
  build_project_inputs false
  echo "Pinned headless acceptance images and provisioning artifacts are ready."
}

require_published_ci_image_pins() {
  local name value
  for name in ACCEPTANCE_RUNNER_IMAGE ACCEPTANCE_EMULATOR_IMAGE; do
    value=${!name}
    [[ "$value" =~ ^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$ ]] \
      || die "$name is not an immutable published image pin."
  done
}

prepare_published_acceptance_images() {
  doctor_acceptance
  ensure_network
  ensure_cache_volumes
  require_published_ci_image_pins
  : "${GH_TOKEN:?GH_TOKEN is required for published image attestation verification}"
  "$SCRIPT_DIR/verify-ci-image" "$ACCEPTANCE_RUNNER_IMAGE" "$CI_IMAGE_SIGNER_WORKFLOW"
  "$SCRIPT_DIR/verify-ci-image" "$ACCEPTANCE_EMULATOR_IMAGE" "$CI_IMAGE_SIGNER_WORKFLOW"
  acceptance_engine pull "$ACCEPTANCE_RUNNER_IMAGE"
  acceptance_engine pull "$ACCEPTANCE_EMULATOR_IMAGE"
  BUILD_IMAGE=$ACCEPTANCE_RUNNER_IMAGE
  EMULATOR_IMAGE=$ACCEPTANCE_EMULATOR_IMAGE
  mkdir -p "$BUILD_ROOT/images"
  local -a security
  mapfile -t security < <(acceptance_security_args)
  acceptance_engine run --rm "${security[@]}" --network none \
    --volume "$BUILD_ROOT/images:/export" "$BUILD_IMAGE" \
    cp /opt/trackglance/pebble-app-x86_64-debug.apk /export/pebble-app-x86_64-debug.apk
  build_project_inputs false false
}

prepare_published_release_runner() {
  select_static_engine
  [[ "$ACCEPTANCE_RUNNER_IMAGE" =~ ^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$ ]] \
    || die "ACCEPTANCE_RUNNER_IMAGE is not an immutable published image pin."
  : "${GH_TOKEN:?GH_TOKEN is required for published image attestation verification}"
  DEV_CONTAINER_ENGINE=$STATIC_ENGINE \
    "$SCRIPT_DIR/verify-ci-image" "$ACCEPTANCE_RUNNER_IMAGE" "$CI_IMAGE_SIGNER_WORKFLOW"
  "$STATIC_ENGINE" pull "$ACCEPTANCE_RUNNER_IMAGE"
  BUILD_IMAGE=$ACCEPTANCE_RUNNER_IMAGE
}

require_images() {
  for image in "$BUILD_IMAGE" "$EMULATOR_IMAGE"; do
    acceptance_image_exists "$image" \
      || die "Missing image $image; run ./tools/podman-test build first."
  done
  test -s "$BUILD_ROOT/images/pebble-app-x86_64-debug.apk" \
    || die "Missing Pebble App build; run ./tools/podman-test build first."
  test -s "$PROJECT_DIR/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk" \
    || die "Missing bridge APK; run ./tools/podman-test build first."
  test -s "$PROJECT_DIR/watchapp/build/watchapp.pbw" \
    || die "Missing PBW; run ./tools/podman-test build first."
}

require_manual_images() {
  require_images
  acceptance_image_exists "$WEB_IMAGE" \
    || die "Missing manual WebRTC image $WEB_IMAGE; run ./tools/podman-test build first."
  [[ "$(acceptance_image_label "$WEB_IMAGE" io.trackglance.manual-lab)" == 1 ]] \
    || die "The WebRTC image predates manual-lab support; run ./tools/podman-test build first."
}

parse_locus_apk_options() {
  LOCUS_INPUT_DIR=${LOCUS_APKS_DIR:-}
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --locus-apks)
        [[ $# -ge 2 ]] || die "--locus-apks requires a directory"
        LOCUS_INPUT_DIR=$2
        shift 2
        ;;
      *) die "Unknown Locus APK option: $1" ;;
    esac
  done
  [[ -n "$LOCUS_INPUT_DIR" ]] || die "Use --locus-apks DIR or LOCUS_APKS_DIR."
  LOCUS_INPUT_DIR=$(realpath "$LOCUS_INPUT_DIR")
  [[ -d "$LOCUS_INPUT_DIR" ]] || die "The Locus APK directory does not exist."
}

parse_manual_options() {
  MANUAL_PLATFORM=
  local -a locus_options=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform)
        [[ $# -ge 2 ]] || die "--platform requires emery or gabbro"
        [[ -z "$MANUAL_PLATFORM" ]] || die "--platform may be specified only once"
        MANUAL_PLATFORM=$2
        shift 2
        ;;
      --locus-apks)
        [[ $# -ge 2 ]] || die "--locus-apks requires a directory"
        [[ ${#locus_options[@]} -eq 0 ]] || die "--locus-apks may be specified only once"
        locus_options=(--locus-apks "$2")
        shift 2
        ;;
      *) die "Unknown manual option: $1" ;;
    esac
  done
  [[ "$MANUAL_PLATFORM" == emery || "$MANUAL_PLATFORM" == gabbro ]] \
    || die "manual requires --platform emery or --platform gabbro"
  parse_locus_apk_options "${locus_options[@]}"
}

private_locus_fingerprint() {
  local locus_dir=$1
  local -a validation_args
  mapfile -t validation_args < <(build_container_args)
  acceptance_engine run "${validation_args[@]}" --network none \
    --volume "$locus_dir:/private:ro" "$BUILD_IMAGE" \
    python3 /workspace/tools/podman/validate-locus-apks.py --fingerprint-only /private
}

clone_volume() {
  local source=$1 destination=$2
  acceptance_volume_exists "$source" || die "Missing volume $source."
  acceptance_engine volume create "$destination" >/dev/null
  local -a security
  mapfile -t security < <(acceptance_security_args)
  acceptance_engine run --rm --network none "${security[@]}" \
    --volume "$source:/source:ro" --volume "$destination:/destination" \
    "$BASE_IMAGE" sh -eu -c 'cp -a /source/. /destination/'
}

golden_marker() {
  local -a security
  mapfile -t security < <(acceptance_security_args)
  acceptance_engine run --rm --network none "${security[@]}" \
    --volume "$GOLDEN_VOLUME:/data:ro" "$BASE_IMAGE" \
    sh -c 'test -f /data/.trackglance-bootstrap && cat /data/.trackglance-bootstrap'
}

require_current_golden() {
  local locus_dir=$1
  acceptance_volume_exists "$GOLDEN_VOLUME" \
    || die "No golden Android state; run bootstrap first."
  local marker core_apk_sha256 emulator_config_sha256
  local fixture_config_sha256 locus_fingerprint
  marker=$(golden_marker) || die "Golden Android state has no provenance marker; clean and bootstrap again."
  grep -qx "bootstrap_schema=$BOOTSTRAP_SCHEMA" <<<"$marker" \
    || die "Golden Android state uses a stale bootstrap schema; clean and bootstrap again."
  grep -qx "api=32" <<<"$marker" || die "Golden Android state is not API 32."
  grep -qx "emulator=$ANDROID_EMULATOR_VERSION" <<<"$marker" \
    || die "Golden Android state uses stale emulator inputs; clean and bootstrap again."
  grep -qx "system_image=$ANDROID_SYSTEM_IMAGE_SHA256" <<<"$marker" \
    || die "Golden Android state uses a stale system image; clean and bootstrap again."
  emulator_config_sha256=$(sha256sum "$SCRIPT_DIR/podman/android-emulator-entrypoint.sh" | cut -d' ' -f1)
  grep -qx "emulator_config=$emulator_config_sha256" <<<"$marker" \
    || die "Golden Android state uses stale emulator configuration; clean and bootstrap again."
  grep -qx "core=$CORE_APP_COMMIT" <<<"$marker" \
    || die "Golden Android state uses a stale Pebble App; clean and bootstrap again."
  core_apk_sha256=$(sha256sum "$BUILD_ROOT/images/pebble-app-x86_64-debug.apk" | cut -d' ' -f1)
  grep -qx "core_apk=$core_apk_sha256" <<<"$marker" \
    || die "Golden Android state uses a stale Pebble App build; clean and bootstrap again."
  grep -qx "bridge=$RELEASE_VERSION" <<<"$marker" \
    || die "Golden Android state uses a stale bridge; clean and bootstrap again."
  fixture_config_sha256=$(sha256sum "$LOCUS_FIXTURE_CONFIG" | cut -d' ' -f1)
  grep -qx "locus_fixture_config=$fixture_config_sha256" <<<"$marker" \
    || die "Golden Android state uses stale Locus fixture pins; clean and bootstrap again."
  locus_fingerprint=$(private_locus_fingerprint "$locus_dir") \
    || die "Could not fingerprint the current Locus fixture."
  grep -qx "locus=$locus_fingerprint" <<<"$marker" \
    || die "Golden Android state uses stale Locus APK inputs; clean and bootstrap again."
}

create_test_pod() {
  local name=$1 publish_webrtc=${2:-false}
  ensure_network
  ACTIVE_PUBLISH_WEBRTC=$publish_webrtc
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    local -a publish=()
    [[ "$publish_webrtc" == true ]] && publish=(--publish 127.0.0.1:5173:5173)
    podman pod create --name "$name" --network "$NETWORK" "${publish[@]}" >/dev/null
  fi
}

start_android() {
  local name=$1 data_volume=$2 runtime_volume=$3
  local -a security network publish=()
  mapfile -t security < <(acceptance_security_args)
  if [[ "$ACCEPTANCE_ENGINE" == podman ]]; then
    network=(--pod "$ACTIVE_POD")
  else
    network=(--network "$NETWORK")
    [[ "$ACTIVE_PUBLISH_WEBRTC" == true ]] \
      && publish=(--publish 127.0.0.1:5173:5173)
  fi
  acceptance_engine run --detach "${network[@]}" "${publish[@]}" --name "$name" \
    --device /dev/kvm "${security[@]}" \
    --volume "$data_volume:/data" --volume "$runtime_volume:/run/trackglance" \
    "$EMULATOR_IMAGE" >/dev/null
  ACTIVE_ANDROID_CONTAINER=$name
  register_active_container "$name"
}

runner_in_pod() {
  local artifacts=$1
  shift
  local -a arguments
  mapfile -t arguments < <(build_container_args)
  local -a network
  mapfile -t network < <(active_network_args)
  acceptance_engine run "${arguments[@]}" "${network[@]}" \
    --volume "$ACTIVE_RUNTIME_VOLUME:/run/trackglance" \
    --volume "$artifacts:/artifacts" \
    "$BUILD_IMAGE" "$@"
}

stop_active_pod() {
  if [[ "$ACCEPTANCE_ENGINE" == docker ]]; then
    local container index
    for ((index=${#ACTIVE_CONTAINERS[@]} - 1; index >= 0; index--)); do
      container=${ACTIVE_CONTAINERS[$index]}
      docker rm --force "$container" >/dev/null 2>&1 || true
    done
    ACTIVE_CONTAINERS=()
    ACTIVE_ANDROID_CONTAINER=
    ACTIVE_POD=
  elif [[ -n "$ACTIVE_POD" ]]; then
    podman pod stop --time 15 "$ACTIVE_POD" >/dev/null 2>&1 || true
    podman pod rm --force "$ACTIVE_POD" >/dev/null 2>&1 || true
    ACTIVE_POD=
  fi
}

stop_active_android_gracefully() {
  [[ -n "$ACTIVE_ANDROID_CONTAINER" ]] || die "No active Android container to stop."
  timeout 75 "$ACCEPTANCE_ENGINE" stop --time 60 "$ACTIVE_ANDROID_CONTAINER" >/dev/null \
    || die "Android emulator container did not stop within its graceful shutdown deadline."
  local state
  state=$("$ACCEPTANCE_ENGINE" inspect --format '{{.State.Status}}' "$ACTIVE_ANDROID_CONTAINER")
  [[ "$state" == exited ]] || die "Android emulator container remained in state $state."
}

bootstrap() {
  parse_locus_apk_options "$@"
  local locus_dir=$LOCUS_INPUT_DIR
  local automated=${ACCEPTANCE_BOOTSTRAP_AUTOMATED:-0}
  require_images
  [[ "$automated" == 1 ]] || acceptance_image_exists "$WEB_IMAGE" \
    || die "Interactive bootstrap needs $WEB_IMAGE; run ./tools/podman-test build first."
  acceptance_volume_exists "$GOLDEN_VOLUME" \
    && die "Golden state already exists; run clean before replacing onboarding or APK inputs."

  local -a validation_args
  mapfile -t validation_args < <(build_container_args)
  acceptance_engine run "${validation_args[@]}" --network none \
    --volume "$locus_dir:/private:ro" "$BUILD_IMAGE" \
    python3 /workspace/tools/podman/validate-locus-apks.py \
      --fixture-config /workspace/tools/locus-test-apk.properties /private

  acceptance_engine volume create "$GOLDEN_VOLUME" >/dev/null
  ACTIVE_DATA_VOLUME=$GOLDEN_VOLUME
  ACTIVE_RUNTIME_VOLUME=trackglance-bootstrap-runtime
  acceptance_engine volume create "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_POD=trackglance-bootstrap
  if [[ "$automated" == 1 ]]; then
    create_test_pod "$ACTIVE_POD" false
  else
    create_test_pod "$ACTIVE_POD" true
  fi
  start_android trackglance-bootstrap-android "$GOLDEN_VOLUME" "$ACTIVE_RUNTIME_VOLUME"
  local -a security network
  mapfile -t security < <(acceptance_security_args)
  mapfile -t network < <(active_network_args)
  if [[ "$automated" != 1 ]]; then
    acceptance_engine run --detach "${network[@]}" --name trackglance-bootstrap-web \
      "${security[@]}" --volume "$ACTIVE_RUNTIME_VOLUME:/run/trackglance:ro" \
      "$WEB_IMAGE" >/dev/null
    register_active_container trackglance-bootstrap-web
  fi

  local artifacts="$BUILD_ROOT/bootstrap-artifacts"
  mkdir -p "$artifacts"
  local -a runner_args
  mapfile -t runner_args < <(build_container_args)
  acceptance_engine run "${runner_args[@]}" "${network[@]}" \
    --env "ACCEPTANCE_BOOTSTRAP_AUTOMATED=$automated" \
    --volume "$ACTIVE_RUNTIME_VOLUME:/run/trackglance" \
    --volume "$locus_dir:/private:ro" \
    --volume "$artifacts:/artifacts" \
    "$BUILD_IMAGE" bash -euo pipefail -c '
      source /workspace/tools/podman/device-lib.sh
      wait_for_android 180
      adb_device_timeout 180 install -r /workspace/build/podman/images/pebble-app-x86_64-debug.apk >/dev/null
      mapfile -d "" apks < <(find /private -maxdepth 1 -type f -name "*.apk" -print0)
      (( ${#apks[@]} > 0 ))
      adb_device_timeout 300 install-multiple -r "${apks[@]}" >/dev/null
      grant_locus_test_permissions
      adb_device_timeout 180 install -r /workspace/android/app/build/outputs/apk/debug/trackglance-bridge-debug.apk >/dev/null
      adb_device shell monkey -p coredevices.coreapp 1 >/dev/null
      adb_device shell monkey -p menion.android.locus 1 >/dev/null
      if [[ "$ACCEPTANCE_BOOTSTRAP_AUTOMATED" == 1 ]]; then
        complete_locus_onboarding 90
        # Do not freeze a golden volume while Locus is still completing its first map/database
        # initialization. A top-resumed activity alone precedes that work on slower cold runners.
        foreground_locus 30
      fi
      adb_device shell am start -W \
        -n app.trackglance.bridge/io.github.christianherget.trackglance.bridge.MainActivity >/dev/null
    '

  if [[ "$automated" != 1 ]]; then
    echo "Complete Pebble App and Locus Map onboarding at http://127.0.0.1:5173/."
    echo "Configure at least one Locus Map recording profile and leave recording stopped."
  fi
  if [[ "$automated" != 1 && "${PODMAN_BOOTSTRAP_READY:-0}" != 1 ]]; then
    [[ -t 0 ]] || die "Bootstrap needs a terminal, or PODMAN_BOOTSTRAP_READY=1 after scripted onboarding."
    read -r -p "Press Enter after onboarding is complete... "
  fi

  acceptance_engine run "${runner_args[@]}" "${network[@]}" \
    --volume "$ACTIVE_RUNTIME_VOLUME:/run/trackglance" \
    --volume "$locus_dir:/private:ro" \
    --volume "$GOLDEN_VOLUME:/golden" \
    "$BUILD_IMAGE" bash -euo pipefail -c "
      source /workspace/tools/podman/device-lib.sh
      wait_status locus_available true 45
      wait_status recording_state STOPPED 15
      wait_nonempty_status locus_profiles 30 >/dev/null
      adb_device uninstall app.trackglance.bridge >/dev/null 2>&1 || true
      fingerprint=\$(python3 /workspace/tools/podman/validate-locus-apks.py --fingerprint-only /private)
      core_apk=\$(sha256sum /workspace/build/podman/images/pebble-app-x86_64-debug.apk | cut -d' ' -f1)
      emulator_config=\$(sha256sum /workspace/tools/podman/android-emulator-entrypoint.sh | cut -d' ' -f1)
      fixture_config=\$(sha256sum /workspace/tools/locus-test-apk.properties | cut -d' ' -f1)
      # Locus initializes and writes its PROJ database asynchronously. Close it and flush the
      # guest filesystem before capturing the reusable volume so a cold clone cannot inherit a
      # partially written SQLite database.
      adb_device shell am force-stop menion.android.locus
      adb_device shell sync
      printf 'bootstrap_schema=%s\\napi=32\\nemulator=%s\\nsystem_image=%s\\nemulator_config=%s\\ncore=%s\\ncore_apk=%s\\nbridge=$RELEASE_VERSION\\nlocus_fixture_config=%s\\nlocus=%s\\n' \\
        '$BOOTSTRAP_SCHEMA' '$ANDROID_EMULATOR_VERSION' '$ANDROID_SYSTEM_IMAGE_SHA256' \\
        \"\$emulator_config\" '$CORE_APP_COMMIT' \"\$core_apk\" \\
        \"\$fixture_config\" \"\$fingerprint\" \\
        > /golden/.trackglance-bootstrap
    "
  stop_active_android_gracefully
  stop_active_pod
  ACTIVE_DATA_VOLUME=
  acceptance_engine volume rm --force "$ACTIVE_RUNTIME_VOLUME" >/dev/null
  ACTIVE_RUNTIME_VOLUME=
  echo "Golden API 32 state is ready; Locus remains only in the private Android data volume."
}

new_run() {
  local stage=$1
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-${stage}-$$"
  RUN_ARTIFACTS="$BUILD_ROOT/$RUN_ID"
  mkdir -p "$RUN_ARTIFACTS"
}

collect_manual_artifacts() {
  [[ -n "$MANUAL_ARTIFACTS" && "$MANUAL_COLLECTED" == false ]] || return 0
  MANUAL_COLLECTED=true
  mkdir -p "$MANUAL_ARTIFACTS"
  local suffix container
  if [[ -n "$ACTIVE_POD" && -n "$ACCEPTANCE_ENGINE" ]]; then
    for suffix in android watch manual web; do
      container="${ACTIVE_POD}-${suffix}"
      timeout 15 "$ACCEPTANCE_ENGINE" logs --tail 4000 "$container" 2>&1 \
        | tail -c 5242880 > "$MANUAL_ARTIFACTS/${suffix}-container.log" || true
    done
  fi
  if [[ -n "$ACTIVE_RUNTIME_VOLUME" && -n "$ACTIVE_POD" ]]; then
    runner_in_pod "$MANUAL_ARTIFACTS" bash -euo pipefail -c '
      source /workspace/tools/podman/device-lib.sh
      adb_device_timeout 20 logcat -d -t 20000 > /artifacts/android-logcat.txt || true
      adb_device_timeout 10 shell content query --uri "$STATUS_URI" > /artifacts/final-status.txt || true
      dump_ui || true
      [[ ! -s /tmp/trackglance-window.xml ]] \
        || cp /tmp/trackglance-window.xml /artifacts/final-ui.xml
      for file in /artifacts/pebble-*.serial.log /artifacts/relay-*.jsonl; do
        [[ -f "$file" ]] || continue
        tail -c 5242880 "$file" > "$file.bounded"
        mv "$file.bounded" "$file"
      done
    ' >/dev/null 2>&1 || true
  fi
}

