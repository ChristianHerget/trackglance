# Published image references are updated only after publish-ci-images.yml has
# produced and attested a new immutable image set. UNPUBLISHED keeps source
# builds authoritative during the initial bootstrap and during pin refreshes.
CI_IMAGE_SET_SCHEMA=1
CI_IMAGE_SOURCE_REPOSITORY=ChristianHerget/trackglance
ACCEPTANCE_RUNNER_IMAGE=UNPUBLISHED
ACCEPTANCE_EMULATOR_IMAGE=UNPUBLISHED
CODEQL_KOTLIN_IMAGE=UNPUBLISHED
