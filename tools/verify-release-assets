#!/bin/bash
set -euo pipefail

candidate=${1:?Usage: verify-release-assets CANDIDATE_DIR VERSION}
version=${2:?Usage: verify-release-assets CANDIDATE_DIR VERSION}

[[ "$version" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]] || {
  echo "Release version must be MAJOR.MINOR.PATCH: $version" >&2
  exit 1
}
[[ -d "$candidate" ]] || {
  echo "Release candidate directory does not exist: $candidate" >&2
  exit 1
}

expected=(
  SHA256SUMS
  "trackglance-bridge-$version.apk"
  "trackglance-bridge-$version.cdx.json"
  "trackglance-bridge-$version.spdx.json"
  "trackglance-docs-$version.tar.gz"
  trackglance-release-certificate.pem
  trackglance-release-certificate.sha256
  "trackglance-watch-$version.cdx.json"
  "trackglance-watch-$version.pbw"
  "trackglance-watch-$version.spdx.json"
)
mapfile -t actual < <(find "$candidate" -maxdepth 1 -type f -printf '%f\n' | sort)
mapfile -t sorted_expected < <(printf '%s\n' "${expected[@]}" | sort)
if [[ "${actual[*]}" != "${sorted_expected[*]}" ]]; then
  echo "Release candidate has a missing or unexpected asset." >&2
  diff -u <(printf '%s\n' "${sorted_expected[@]}") <(printf '%s\n' "${actual[@]}") || true
  exit 1
fi

for asset in "${expected[@]}"; do
  [[ -s "$candidate/$asset" ]] || {
    echo "Release asset is empty: $asset" >&2
    exit 1
  }
done

(cd "$candidate" && sha256sum --check --strict SHA256SUMS)
expected_checksum_targets=()
for asset in "${expected[@]}"; do
  [[ "$asset" == SHA256SUMS ]] || expected_checksum_targets+=("./$asset")
done
mapfile -t sorted_expected_checksum_targets < <(
  printf '%s\n' "${expected_checksum_targets[@]}" | sort
)
mapfile -t actual_checksum_targets < <(
  awk '{print $2}' "$candidate/SHA256SUMS" | sed 's/^\*//' | sort
)
if [[ "${actual_checksum_targets[*]}" != "${sorted_expected_checksum_targets[*]}" ]]; then
  echo "SHA256SUMS must cover every public asset except itself exactly once." >&2
  diff -u \
    <(printf '%s\n' "${sorted_expected_checksum_targets[@]}") \
    <(printf '%s\n' "${actual_checksum_targets[@]}") || true
  exit 1
fi
