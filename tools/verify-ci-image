#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage: $0 IMAGE@sha256:DIGEST WORKFLOW" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage
image=$1
workflow=$2
[[ "$image" =~ ^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$ ]] || {
  echo "Refusing a CI image that is not an immutable GHCR SHA-256 reference: $image" >&2
  exit 1
}
[[ "$workflow" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\.github/workflows/[A-Za-z0-9_.-]+@refs/heads/main$ ]] || {
  echo "Refusing an untrusted workflow identity: $workflow" >&2
  exit 1
}

: "${GH_TOKEN:?GH_TOKEN is required to verify GitHub attestations}"
command -v gh >/dev/null || { echo "gh is required" >&2; exit 1; }

gh attestation verify "oci://$image" \
  --repo "${workflow%%/.github/workflows/*}" \
  --signer-workflow "${workflow%@*}" \
  --source-ref refs/heads/main

cosign_args=(
  verify "$image"
  --certificate-oidc-issuer https://token.actions.githubusercontent.com
  --certificate-identity "https://github.com/$workflow"
)
if command -v cosign >/dev/null; then
  cosign "${cosign_args[@]}" >/dev/null
else
  cosign_image=ghcr.io/sigstore/cosign/cosign@sha256:6ca1127dc1e9ff19f3f2bfa214936813a86fbbf52919652eda49d393c888ad3c
  if [[ -n "${DEV_CONTAINER_ENGINE:-}" ]]; then
    engine=$DEV_CONTAINER_ENGINE
  elif command -v docker >/dev/null; then
    engine=docker
  elif command -v podman >/dev/null; then
    engine=podman
  else
    echo "cosign or a Docker-compatible container engine is required" >&2
    exit 1
  fi
  "$engine" run --rm "$cosign_image" "${cosign_args[@]}" >/dev/null
fi
