ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG ANDROID_CMDLINE_TOOLS_VERSION
ARG ANDROID_CMDLINE_TOOLS_SHA256
ARG ANDROID_PLATFORM_TOOLS_VERSION
ARG ANDROID_PLATFORM_32_REVISION
ARG ANDROID_PLATFORM_36_REVISION
ARG ANDROID_PLATFORM_37_REVISION
ARG ANDROID_BUILD_TOOLS_VERSION
ARG ANDROID_NDK_VERSION
ARG ANDROID_CMAKE_VERSION
ARG PEBBLE_TOOL_VERSION
ARG PEBBLE_SDK_VERSION
ARG UV_VERSION
ARG UV_X86_64_SHA256
ARG ACTIONLINT_VERSION
ARG ACTIONLINT_X86_64_SHA256

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    XDG_DATA_HOME=/opt/pebble-data \
    UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/${ANDROID_BUILD_TOOLS_VERSION}:/usr/local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        bzip2 ca-certificates clang cmake curl file gcc git libc6-dev libasound2 \
        libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libdbus-1-3 libfdt1 libfontconfig1 \
        libgl1 libglib2.0-0 libnss3 libpixman-1-0 libpulse0 \
        libsdl2-2.0-0 libtinfo6 libx11-6 libxcb1 libxcomposite1 libxcursor1 \
        libxdamage1 libxext6 libxfixes3 libxi6 make nodejs npm openjdk-17-jdk-headless \
        python3 python3-pip python3-venv shellcheck unzip xz-utils zip zlib1g && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-tools && \
    curl --fail --location --retry 4 \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
      --output /tmp/android-tools/commandlinetools.zip && \
    echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-tools/commandlinetools.zip" | sha256sum --check --strict && \
    unzip -q /tmp/android-tools/commandlinetools.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm -rf /tmp/android-tools && \
    yes | sdkmanager --licenses >/dev/null && \
    sdkmanager --install \
      "platform-tools" \
      "platforms;android-32" \
      "platforms;android-36" \
      "platforms;android-37.0" \
      "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
      "ndk;${ANDROID_NDK_VERSION}" \
      "cmake;${ANDROID_CMAKE_VERSION}" >/dev/null && \
    sdk_revision() { sed -n 's/^Pkg.Revision[[:space:]]*=[[:space:]]*//p' "$1/source.properties"; } && \
    test "$(sdk_revision /opt/android-sdk/platform-tools)" = "${ANDROID_PLATFORM_TOOLS_VERSION}" && \
    test "$(sdk_revision /opt/android-sdk/platforms/android-32)" = "${ANDROID_PLATFORM_32_REVISION}" && \
    test "$(sdk_revision /opt/android-sdk/platforms/android-36)" = "${ANDROID_PLATFORM_36_REVISION}" && \
    test "$(sdk_revision /opt/android-sdk/platforms/android-37.0)" = "${ANDROID_PLATFORM_37_REVISION}" && \
    test "$(sdk_revision /opt/android-sdk/build-tools/${ANDROID_BUILD_TOOLS_VERSION})" = "${ANDROID_BUILD_TOOLS_VERSION}" && \
    test "$(sdk_revision /opt/android-sdk/ndk/${ANDROID_NDK_VERSION})" = "${ANDROID_NDK_VERSION}" && \
    test "$(sdk_revision /opt/android-sdk/cmake/${ANDROID_CMAKE_VERSION})" = "${ANDROID_CMAKE_VERSION}"

RUN curl --fail --location --retry 4 \
      "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
      --output /tmp/uv.tar.gz && \
    echo "${UV_X86_64_SHA256}  /tmp/uv.tar.gz" | sha256sum --check --strict && \
    tar -xzf /tmp/uv.tar.gz -C /tmp && \
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv && \
    rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu && \
    uv python install 3.13 && \
    uv tool install "ruff==0.16.4" --python 3.13 && \
    uv tool install "pebble-tool==${PEBBLE_TOOL_VERSION}" --python 3.13 && \
    pebble sdk install "${PEBBLE_SDK_VERSION}" && \
    pebble sdk activate "${PEBBLE_SDK_VERSION}"

RUN curl --fail --location --retry 4 \
      "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
      --output /tmp/actionlint.tar.gz && \
    echo "${ACTIONLINT_X86_64_SHA256}  /tmp/actionlint.tar.gz" | sha256sum --check --strict && \
    tar -xzf /tmp/actionlint.tar.gz -C /tmp actionlint && \
    install -m 0755 /tmp/actionlint /usr/local/bin/actionlint && \
    rm -f /tmp/actionlint.tar.gz /tmp/actionlint

# Docker runs this image as the invoking host UID so generated files stay
# user-owned. Pebble Tool also writes small settings/telemetry state here. The
# isolated screenshot path shares only the installed SDK and remains ephemeral.
RUN chmod -R a+rwX /opt/pebble-data /opt/uv-tools && \
    mkdir -p /tmp/pebble-sdk-data && \
    ln -s /opt/pebble-data/pebble-sdk /tmp/pebble-sdk-data/pebble-sdk && \
    chmod 1777 /tmp/pebble-sdk-data

WORKDIR /workspace
