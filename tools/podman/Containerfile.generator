ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG ANDROID_EMULATOR_SCRIPTS_COMMIT
COPY tools/podman/patches/android-emulator-dest-path.patch /tmp/android-emulator-dest-path.patch
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-pip python3-venv && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    git clone https://github.com/google/android-emulator-container-scripts.git /opt/aemu && \
    git -C /opt/aemu checkout --detach "${ANDROID_EMULATOR_SCRIPTS_COMMIT}" && \
    test "$(git -C /opt/aemu rev-parse HEAD)" = "${ANDROID_EMULATOR_SCRIPTS_COMMIT}" && \
    git -C /opt/aemu apply --check /tmp/android-emulator-dest-path.patch && \
    git -C /opt/aemu apply /tmp/android-emulator-dest-path.patch && \
    python3 -m venv /opt/aemu-venv && \
    /opt/aemu-venv/bin/pip install --no-cache-dir /opt/aemu && \
    rm /tmp/android-emulator-dest-path.patch
ENV PATH=/opt/aemu-venv/bin:$PATH
WORKDIR /work
