#!/bin/bash
set -euo pipefail

candidate=${1:?Usage: verify-release-candidate CANDIDATE_DIR TAG SOURCE_COMMIT}
tag=${2:?Usage: verify-release-candidate CANDIDATE_DIR TAG SOURCE_COMMIT}
commit=${3:?Usage: verify-release-candidate CANDIDATE_DIR TAG SOURCE_COMMIT}
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

[[ "$tag" =~ ^v([0-9]+[.][0-9]+[.][0-9]+)$ ]] || {
  echo "Release tag must be vMAJOR.MINOR.PATCH: $tag" >&2
  exit 1
}
version=${BASH_REMATCH[1]}
workflow="$GITHUB_REPOSITORY/.github/workflows/release.yml"
source_ref="refs/tags/$tag"
apk="$candidate/trackglance-bridge-$version.apk"
pbw="$candidate/trackglance-watch-$version.pbw"
docs="$candidate/trackglance-docs-$version.tar.gz"
android_cdx="$candidate/trackglance-bridge-$version.cdx.json"
android_spdx="$candidate/trackglance-bridge-$version.spdx.json"
watch_cdx="$candidate/trackglance-watch-$version.cdx.json"
watch_spdx="$candidate/trackglance-watch-$version.spdx.json"

tools/verify-release-assets "$candidate" "$version"

verify_common=(
  --repo "$GITHUB_REPOSITORY"
  --signer-workflow "$workflow"
  --source-ref "$source_ref"
  --source-digest "$commit"
  --deny-self-hosted-runners
)
for asset in "$apk" "$pbw" "$docs"; do
  gh attestation verify "$asset" "${verify_common[@]}"
done

verify_sbom() {
  local artifact=$1 sbom=$2 predicate=$3 attestations
  attestations=$(mktemp)
  if ! gh attestation verify "$artifact" "${verify_common[@]}" \
    --predicate-type "$predicate" --format json > "$attestations"; then
    rm -f "$attestations"
    return 1
  fi
  if ! jq -e --slurpfile expected "$sbom" \
    'any(.[]; .verificationResult.statement.predicate == $expected[0])' \
    "$attestations" >/dev/null; then
    rm -f "$attestations"
    echo "Downloaded SBOM does not match a verified $predicate predicate: $sbom" >&2
    return 1
  fi
  rm -f "$attestations"
}

jq -e '.bomFormat == "CycloneDX" and .specVersion == "1.6"' \
  "$android_cdx" "$watch_cdx" >/dev/null
jq -e '.spdxVersion == "SPDX-2.3"' "$android_spdx" "$watch_spdx" >/dev/null
verify_sbom "$apk" "$android_cdx" https://cyclonedx.org/bom
verify_sbom "$apk" "$android_spdx" https://spdx.dev/Document/v2.3
verify_sbom "$pbw" "$watch_cdx" https://cyclonedx.org/bom
verify_sbom "$pbw" "$watch_spdx" https://spdx.dev/Document/v2.3
