#!/usr/bin/env python3
"""Resolve a GHCR tag; exit 3 only for a confirmed missing manifest."""

import base64
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request


class RegistryError(Exception):
    pass


def request(url, headers):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as response:
            return response.status, response.headers, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.headers, error.read()
    except (OSError, urllib.error.URLError) as error:
        raise RegistryError(f"Registry request failed: {error}") from error


def resolve(image, actor, credential):
    match = re.fullmatch(r"ghcr\.io/([a-z0-9_.-]+/[a-z0-9_.-]+):([a-f0-9]{20})", image)
    if not match:
        raise RegistryError(f"Expected a GHCR image with a 20-character input key: {image}")
    repository, tag = match.groups()
    query = urllib.parse.urlencode({"service": "ghcr.io", "scope": f"repository:{repository}:pull"})
    basic = base64.b64encode(f"{actor}:{credential}".encode()).decode()
    status, _, body = request(f"https://ghcr.io/token?{query}", {"Authorization": f"Basic {basic}"})
    if status != 200:
        raise RegistryError(f"Registry authentication failed (HTTP {status}) for {image}")
    token = json.loads(body).get("token")
    if not isinstance(token, str) or not token:
        raise RegistryError(f"Registry authentication returned no token for {image}")
    status, headers, body = request(
        f"https://ghcr.io/v2/{repository}/manifests/{tag}",
        {
            "Authorization": f"Bearer {token}",
            "Accept": ", ".join((
                "application/vnd.oci.image.manifest.v1+json",
                "application/vnd.oci.image.index.v1+json",
                "application/vnd.docker.distribution.manifest.v2+json",
                "application/vnd.docker.distribution.manifest.list.v2+json",
            )),
        },
    )
    if status == 404:
        errors = json.loads(body).get("errors", [])
        if errors and all(error.get("code") == "MANIFEST_UNKNOWN" for error in errors):
            return None
    if status != 200:
        raise RegistryError(f"Manifest resolution failed (HTTP {status}) for {image}; absence is unconfirmed")
    digest = headers.get("Docker-Content-Digest", "")
    if not re.fullmatch(r"sha256:[a-f0-9]{64}", digest):
        raise RegistryError(f"Registry returned no valid SHA-256 digest for {image}")
    if digest != "sha256:" + hashlib.sha256(body).hexdigest():
        raise RegistryError(f"Registry manifest digest mismatch for {image}")
    return f"ghcr.io/{repository}@{digest}"


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} ghcr.io/OWNER/IMAGE:KEY", file=sys.stderr)
        return 2
    try:
        reference = resolve(sys.argv[1], os.environ["GITHUB_ACTOR"], os.environ["GH_TOKEN"])
        if reference is None:
            return 3
        print(reference)
        return 0
    except (RegistryError, ValueError, KeyError, AttributeError, TypeError) as error:
        print(f"Cannot resolve {sys.argv[1]}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
