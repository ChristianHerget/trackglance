#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
ndk=$(sed -nE 's/^ANDROID_NDK_VERSION=(.*)/\1/p' tools/podman/versions.env)
clang="${ANDROID_SDK_ROOT:?}/ndk/$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
analysis_dir=$(mktemp -d)
trap 'rm -rf "$analysis_dir"' EXIT
for source in watchapp/src/c/watch_config.c watchapp/src/c/watch_state.c watchapp/src/c/persistent_blob.c watchapp/src/c/i18n.c watchapp/src/c/ui_metrics.c; do
  output="$analysis_dir/$(basename "$source").plist"
  "$clang" --target=x86_64-unknown-linux-gnu --gcc-toolchain=/usr --analyze -std=c11 \
    -Wall -Wextra -Werror -pedantic -Iwatchapp/test/fakes -Iwatchapp/src/c "$source" -o "$output"
done
