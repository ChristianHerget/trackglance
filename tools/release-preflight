#!/usr/bin/env bash
set -euo pipefail

tag=${1:-}
[[ "$tag" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || {
  echo "Tag must have the strict form vMAJOR.MINOR.PATCH." >&2
  exit 1
}
version=${tag#v}
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

protocol_version=$(sed -nE 's/.*release, currently `([0-9]+\.[0-9]+\.[0-9]+)`\..*/\1/p' protocol/README.md)
[[ -n "$protocol_version" ]] || {
  echo 'Missing protocol release marker: expected release, currently `MAJOR.MINOR.PATCH`.' >&2
  exit 1
}
values=(
  "$(sed -nE 's/^[[:space:]]*versionName[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' android/app/build.gradle.kts)"
  "$(sed -nE 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' watchapp/package.json | head -n1)"
  "$(sed -nE 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' watchapp/package-lock.json | head -n1)"
  "$(sed -nE 's/^#define RELEASE_VERSION "([^"]+)"/\1/p' watchapp/src/c/main.c)"
  "$(sed -nE "s/^  var RELEASE = '([^']+)';/\1/p" watchapp/src/pkjs/index.js)"
  "$(sed -nE "s/^version = '([^']+)'/\1/p" docs/sphinx/conf.py)"
  "$protocol_version"
)
for actual in "${values[@]}"; do
  [[ "$actual" == "$version" ]] || {
    echo "Version mismatch: tag $version but a release source says ${actual:-<missing>}." >&2
    exit 1
  }
done

git fetch --quiet origin main
commit=$(git rev-list -n 1 "$tag^{commit}")
main_commit=$(git rev-parse 'origin/main^{commit}')
[[ "$commit" == "$main_commit" ]] || {
  echo "Tag commit $commit is not the current origin/main commit $main_commit." >&2
  exit 1
}
echo "Release preflight passed for $tag at $commit."
